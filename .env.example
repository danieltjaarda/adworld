# ---------------------------------------------------------------------------
# AdLeverage — environment configuration
#
# Copy to `.env` and fill in what you have. Every integration degrades to a mock
# provider when its credentials are absent, so the app boots and is fully usable
# in demo mode with nothing but DATABASE_URL and AUTH_SECRET.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Any Postgres URL. Serverless needs a pooled one: every invocation opens its own
# connection, so an unpooled database runs out of slots under mild load.
DATABASE_URL="postgresql://user:password@localhost:5432/adleverage"
# Direct (non-pooled) connection. Only the Prisma CLI uses it, because a pooler in
# transaction mode cannot run schema changes. Leave empty for a plain local Postgres.
# On Vercel the Neon integration injects this as DATABASE_URL_UNPOOLED and the CLI
# picks that up automatically — see prisma.config.ts.
DIRECT_URL=""

# --- Security (required) ---------------------------------------------------
# Signs sessions and derives the token-encryption key.
#   openssl rand -base64 48
AUTH_SECRET=""
# Optional. 32 bytes, hex or base64, for encrypting stored OAuth tokens.
# Derived from AUTH_SECRET when empty — set it explicitly if you ever want to
# rotate AUTH_SECRET without invalidating every stored Google connection.
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# Public base URL. Must match the OAuth redirect URIs registered with Google.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth + Google Ads API -----------------------------------------
# Without these the app runs in demo mode against generated sample data.
# Google Cloud console -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URIs:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   {NEXT_PUBLIC_APP_URL}/api/google-ads/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Ads API Center -> developer token (basic access is enough to start).
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Only when accounts are reached through an MCC; can be set per connection too.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_API_VERSION="v21"

# --- LLM provider ----------------------------------------------------------
# Any OpenAI-compatible endpoint. Without a key the optimizer still runs: rules
# and statistics are deterministic, only the narration and copy generation stop.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
# Optional larger model for account-level analysis.
OPENAI_REASONING_MODEL=""

# --- Stripe billing --------------------------------------------------------
# Without a secret key every workspace stays on the Free plan and /billing
# explains that billing is not configured.
STRIPE_SECRET_KEY=""
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Price ids map to plan tiers. Change a price in Stripe, not in code.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_AGENCY=""

# --- Transactional email ---------------------------------------------------
# Without a key, verification and reset links are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="AdLeverage <noreply@adleverage.app>"

# --- Background jobs -------------------------------------------------------
# Shared secret for the /api/cron/* routes. Vercel Cron sends it automatically
# as a bearer token; set the same value in the project's environment variables.
CRON_SECRET=""

# --- Rate limiting (optional) ----------------------------------------------
# Falls back to an in-memory limiter, which is per-instance and resets on
# deploy. Set these for a limit that holds across serverless instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Diagnostics -----------------------------------------------------------
LOG_LEVEL="info"
# Force demo data even when Google credentials exist.
DEMO_MODE="false"
